# Notion integration token. Keep the real value in .env, never commit it.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# In current Notion API versions this is the data source ID of the database.
NOTION_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_VERSION=2026-03-11

# These names must match the properties in the Notion database.
NOTION_STATUS_PROPERTY=Publish Status
NOTION_PUBLISHED_STATUS=Published
# Optional: leave this property unset/blank to derive the .md filename from
# the Notion page title. Example: "1단계: Docker Compose" becomes
# "1단계-Docker-Compose.md".
NOTION_WIKI_PATH_PROPERTY=Wiki Path
NOTION_WIKI_URL_PROPERTY=GitHub Wiki URL
NOTION_LAST_SHA_PROPERTY=Last Commit SHA
NOTION_LAST_SYNCED_PROPERTY=Last Synced At

# SSH URL is recommended if your local GitHub SSH key is configured.
WIKI_REPO_URL=git@github.com:100-hours-a-week/KTB4-3rd-CLOUD.wiki.git
# Insert a table of contents at the top of each Wiki page
# (H1 headings if the page has any, otherwise H2).
WIKI_TOC=true
WIKI_TOC_TITLE=목차
WIKI_BASE_URL=https://github.com/100-hours-a-week/KTB4-3rd-CLOUD/wiki

# Needed only when using an HTTPS Wiki URL without a Git credential manager.
# Prefer a least-privilege token with access to the Wiki repository.
GITHUB_TOKEN=
GIT_AUTHOR_NAME=Notion Wiki Sync
GIT_AUTHOR_EMAIL=notion-wiki-sync@localhost
