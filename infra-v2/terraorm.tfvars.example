project_name = "moyeota-v2"
aws_region   = "ap-northeast-2"
aws_profile  = null
# Verify there is no overlap with the V1 VPC, VPN, or connected networks before apply.
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["ap-northeast-2a", "ap-northeast-2c"]
prod_app_instance_type       = "t3.medium"
prod_websocket_instance_type = "t3.medium"
dev_instance_type            = "t3.medium"
root_volume_size_gib         = 30
dev_data_volume_size_gib     = 30
# Leave null until an ACM certificate in ap-northeast-2 is ready.
alb_certificate_arn            = null
alb_ingress_cidrs              = ["0.0.0.0/0"]
alb_cloudfront_prefix_list_id  = null
docker_compose_version     = "v2.39.4"
frontend_port              = 3000
rest_port                  = 8080
fastapi_port               = 8000
websocket_port             = 8080
spring_management_port     = 8090
alb_idle_timeout_seconds   = 300