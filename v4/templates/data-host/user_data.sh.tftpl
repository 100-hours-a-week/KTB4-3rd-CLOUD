#!/usr/bin/env bash
# v4 데이터 호스트 부트스트랩 (data_host.tf, Amazon Linux 2023)
#   1) Docker 설치  2) 데이터 EBS 포맷·마운트  3) 스크립트 배치(gzip+base64)  4) data-host-apply 실행
#   데이터 EBS는 인스턴스 생성 뒤에 연결되므로 최대 5분 기다린다.
set -Eeuo pipefail
exec > >(tee /var/log/data-host-bootstrap.log | logger -t data-host-bootstrap -s 2>/dev/console) 2>&1

DATA_MOUNT="/mnt/data"
APP_DIR="/opt/data-host"

dnf install -y docker xfsprogs openssl
systemctl enable --now amazon-ssm-agent

root_source="$(findmnt -n -o SOURCE /)"
root_disk="$(lsblk -no PKNAME "$${root_source}" 2>/dev/null || true)"
data_device=""
for _ in $(seq 1 60); do
  while read -r candidate candidate_type; do
    [[ "$${candidate_type}" == "disk" ]] || continue
    [[ "$(basename "$${candidate}")" == "$${root_disk}" ]] && continue
    data_device="$${candidate}"
    break
  done < <(lsblk -dnpo NAME,TYPE)
  [[ -n "$${data_device}" ]] && break
  sleep 5
done
if [[ -z "$${data_device}" ]]; then
  echo "data EBS did not appear within 300 seconds" >&2
  exit 1
fi

install -d -m 0755 "$${DATA_MOUNT}"
if ! blkid "$${data_device}" >/dev/null 2>&1; then
  mkfs.xfs -f "$${data_device}"
fi
data_uuid="$(blkid -s UUID -o value "$${data_device}")"
grep -q "UUID=$${data_uuid} $${DATA_MOUNT} " /etc/fstab || \
  echo "UUID=$${data_uuid} $${DATA_MOUNT} xfs defaults,nofail 0 2" >> /etc/fstab
mountpoint -q "$${DATA_MOUNT}" || mount "$${DATA_MOUNT}"

# 재부팅 때 Docker가 데이터 볼륨보다 먼저 떠서 빈 디렉터리에 컨테이너를 붙이지 않게 한다.
install -d -m 0755 /etc/systemd/system/docker.service.d
cat >/etc/systemd/system/docker.service.d/10-data-mount.conf <<UNIT
[Unit]
RequiresMountsFor=$${DATA_MOUNT}
UNIT
systemctl daemon-reload
systemctl enable --now docker

install -d -m 0750 "$${APP_DIR}"
echo "${apply_b64}" | base64 -d | gunzip > /usr/local/bin/data-host-apply
chmod 0750 /usr/local/bin/data-host-apply
echo "${topics_b64}" | base64 -d | gunzip > "$${APP_DIR}/topics.sh"
chmod 0644 "$${APP_DIR}/topics.sh"

/usr/local/bin/data-host-apply
