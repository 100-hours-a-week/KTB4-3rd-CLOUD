project_name = "moyeota-v2"
aws_region   = "ap-northeast-2"
aws_profile  = null

# From infra/terraform.tfstate. Verify this ID against the live AWS account.
vpc_id = "vpc-054f8f601f1b9f1b3"

availability_zones = ["ap-northeast-2a", "ap-northeast-2c"]

# Candidate CIDRs avoid the V1 state subnets 10.20.10.0/24 and
# 10.20.20.0/24. Check all live VPC subnets before using these values.
subnet_cidrs = {
  public_a = "10.20.30.0/24"
  public_b = "10.20.31.0/24"
  app      = "10.20.40.0/24"
  dev      = "10.20.41.0/24"
  data_a   = "10.20.100.0/24"
  data_b   = "10.20.101.0/24"
  # 모니터링 호스트 전용 서브넷 (선택). 비워 두면 모니터링 호스트는 app 서브넷에 둔다.
  ops = "10.20.43.0/24"
}

# private 워크로드의 S3 트래픽을 NAT 대신 Gateway Endpoint로 보낸다
s3_gateway_endpoint_enabled = true

prod_app_instance_type       = "t3.small"
prod_websocket_instance_type = "t3.medium"
dev_instance_type            = "t3.medium"
root_volume_size_gib         = 30
dev_data_volume_size_gib     = 30

# Leave null until an ACM certificate in ap-northeast-2 is ready.
alb_certificate_arn           = null
alb_ingress_cidrs             = ["0.0.0.0/0"]
alb_cloudfront_prefix_list_id = null

docker_compose_version   = "v2.39.4"
frontend_port            = 3000
rest_port                = 8080
fastapi_port             = 8000
websocket_port           = 8080
spring_management_port   = 8090
alb_idle_timeout_seconds = 300

# ECS (ecs.tf)
# 스테이지마다 ASG min_size만큼 인스턴스가 서비스 없이도 뜬다 (prod: rest-od 2 + ws-od 3 + general-od 1).
# dev·stg 스케줄링 테스트 기간에는 prod를 빼 둔다.
ecs_stages              = ["dev", "stg"]
ecs_services            = ["rest", "websocket", "frontend", "fastapi"]
github_org              = "100-hours-a-week"
github_cloud_repository = "KTB4-3rd-CLOUD"

# Prod ECS Exec를 허용할 기존 IAM 그룹. 없으면 null로 두고 SSO Permission Set에 정책을 직접 붙인다.
prod_ecs_operator_group_name = null

# ECS Service 최초 이미지 (스테이지 → 서비스). 이미지가 있는 서비스만 ECS Service가 만들어진다.
# 비워 두면 Cluster·ASG·Capacity Provider·IAM만 생성된다. digest 고정을 권장한다.
ecs_container_images = {
  # stg = {
  #   rest      = "<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/moyeota/be@sha256:<digest>"
  #   websocket = "<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/moyeota/be@sha256:<digest>"
  #   frontend  = "<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/moyeota/fe@sha256:<digest>"
  #   fastapi   = "<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/moyeota/ai@sha256:<digest>"
  # }
}

# false: Prod ECS 규칙은 "X-Moyeota-Stage: prod" 헤더 요청만 받는다 (기존 Compose 라우팅 유지)
# true : Prod 트래픽을 ECS Service로 전환
ecs_prod_alb_cutover = false

# 스테이지별 host 라우팅. dev·stg는 Non-Prod ALB를 공유하고 서브도메인으로만 나눈다.
# ecs_container_images에 dev·stg 이미지를 넣으면 해당 host가 필수다 (DNS는 nonprod_alb_dns_name으로 ALIAS).
# prod(moyeota.com)는 Prod ALB 전용이라 host 조건을 두지 않는다.
ecs_alb_host_headers = {
  dev = ["dev.moyeota.com"]
  stg = ["stg.moyeota.com"]
}

# Non-Prod ALB (dev·stg). dev.moyeota.com·stg.moyeota.com을 포함하는 ACM 인증서. 없으면 HTTP 전용.
nonprod_alb_certificate_arn = null
# 팀·QA CIDR만 허용한다. 비워 두면 Non-Prod ALB에 아무도 접근할 수 없다.
admin_cidrs  = []
dev_qa_cidrs = []

# --- 채팅 브로커 (broker.tf) -------------------------------------------------
# ElastiCache Redis를 만들 스테이지. stg는 테스트 때만 넣고 끝나면 뺀다. prod는 replica 1 + 자동 장애 조치.
# dev는 dev EC2 compose Redis(dev_redis_port)를 쓴다.
# rest·websocket 태스크에는 REDIS_HOST·REDIS_PORT·CHAT_FANOUT_CHANNEL이 SSM(/moyeota/v2/<stage>/broker/*)으로 자동 주입된다.
elasticache_redis_stages = ["stg"]
dev_redis_port           = 6379
# 브로커 알람 알림 (없으면 null — 알람 상태만 남는다)
alarm_sns_topic_arn = null
# dev rest·websocket 태스크 → dev EC2(compose MySQL·Redis). compose에서 포트를 호스트로 publish해야 한다.
dev_data_ports = [3306, 6379]

# --- Non-Prod DNS·인증서 (dns.tf) -------------------------------------------
route53_zone_name = "moyeota.com"
# V1이 쓰는 dev.moyeota.com은 넣지 않는다 (기존 레코드와 충돌). 넘겨받을 때 import 후 추가.
nonprod_dns_records = ["stg.moyeota.com"]
# dev·stg SAN 인증서를 만들어 Non-Prod HTTPS 리스너에 붙인다 (wss:// 테스트). nonprod_alb_certificate_arn을 주면 그 값이 우선.
nonprod_acm_certificate_create = true

# --- CD (Deploy Role OIDC) ---------------------------------------------------
# CD가 도는 앱 레포. GitHub에 표시되는 이름 그대로 (OIDC sub는 대소문자 구분)
github_app_repositories = ["KTB4-3rd-BE", "KTB4-3rd-FE"]

# --- Service Connect · FIS ---------------------------------------------------
# rest·websocket → http://fastapi:8000. 켜면 해당 스테이지 서비스가 새 배포된다.
ecs_service_connect_stages = []
# 장애 주입 실험 템플릿 (실행 전까지 영향 없음). prod는 지정 불가.
fis_stages = ["stg"]

# 중앙 모니터링 (monitoring.tf) — PLG + Alloy
#   켜기 전에 확인: subnet_cidrs.ops(선택), s3_gateway_endpoint_enabled
#   켠 뒤 값 입력: /moyeota/v2/monitoring/{GRAFANA_ADMIN_PASSWORD,DISCORD_WEBHOOK_INCIDENT,DISCORD_WEBHOOK_ALERTS}
monitoring_enabled = false
monitoring_instance_type             = "m7i.large"
monitoring_data_volume_size_gib      = 40
monitoring_prometheus_retention_days = 15
monitoring_loki_retention_days = {
  prod    = 30
  nonprod = 7
}

# 장애 알림 (alerting.tf) — 모니터링 스택과 독립된 CloudWatch Alarm 경로
alerting_enabled        = false
alert_emails            = [] # 예) ["cloud-team@example.com"] — 생성 후 메일에서 구독 확인
alert_stages            = ["prod"]
alert_alb_5xx_threshold = 10
# DISCORD_WEBHOOK_INCIDENT 값을 SSM에 넣은 뒤 켠다
alert_discord_enabled = false
