    {
      "type": "table",
      "title": "V1 Prod — purge 지연·연결·버퍼 풀",
      "description": "history_list_length = InnoDB purge 지연(PostgreSQL dead tuple·vacuum 대체 지표, TC-13). buffer_pool_hit_pct는 기동 후 누적",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-mig-v1"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-mig-v1"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT `COUNT` FROM information_schema.innodb_metrics WHERE NAME = 'trx_rseg_history_len') AS history_list_length,\n  (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Threads_connected') AS threads_connected,\n  (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Threads_running') AS threads_running,\n  @@max_connections AS max_connections,\n  ROUND(100 * (1 - (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Innodb_buffer_pool_reads')\n    / NULLIF((SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Innodb_buffer_pool_read_requests'), 0)), 2) AS buffer_pool_hit_pct"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 20,
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 41
      }
    },
