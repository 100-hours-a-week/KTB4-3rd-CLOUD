        }
      },
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "클라이언트 연결 (V1 backend → ProxySQL)",
      "description": "보류 구간에 non-idle이 늘었다가 RDS ONLINE 직후 내려와야 한다",
      "datasource": {
