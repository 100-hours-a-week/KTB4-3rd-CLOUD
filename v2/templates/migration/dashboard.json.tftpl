    {
      "type": "table",
      "title": "V1 Prod — 잠금 대기 (row · MDL)",
      "description": "sys.innodb_lock_waits(행 잠금) + sys.schema_table_lock_waits(메타데이터 잠금)",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-mig-v1"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-mig-v1"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'row' AS kind, waiting_pid, blocking_pid, wait_age_secs AS wait_s, locked_table AS object, LEFT(IFNULL(waiting_query, ''), 140) AS waiting_query\n  FROM sys.innodb_lock_waits\nUNION ALL\nSELECT 'mdl', waiting_pid, blocking_pid, waiting_query_secs, CONCAT(object_schema, '.', object_name), LEFT(IFNULL(waiting_query, ''), 140)\n  FROM sys.schema_table_lock_waits\nORDER BY wait_s DESC\nLIMIT 20"
        }
