        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "백엔드별 쿼리 처리량",
      "description": "전환 순간 V1 → RDS로 넘어가는 지점이 보류 구간 길이다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (endpoint) (rate(proxysql_connpool_conns_queries_total{job=\"migration-proxysql\", hostgroup=\"10\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
