    {
      "type": "table",
      "title": "V1 Prod — writer 판정",
      "description": "S4에서 super_read_only = ON이 되어야 한다. binlog_dump_threads = 정방향 복제 연결(RDS)",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-mig-v1"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-mig-v1"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  @@server_id AS server_id,\n  @@read_only AS read_only,\n  @@super_read_only AS super_read_only,\n  (SELECT COUNT(*) FROM information_schema.processlist\n    WHERE command NOT IN ('Sleep', 'Daemon', 'Binlog Dump', 'Binlog Dump GTID', 'Connect')\n      AND user NOT IN ('system user', 'event_scheduler', 'mig_mon', 'rdsadmin')) AS active_sessions,\n  (SELECT COUNT(*) FROM information_schema.processlist WHERE command IN ('Binlog Dump', 'Binlog Dump GTID')) AS binlog_dump_threads"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "read_only|super_read_only"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OFF (쓰기 가능)",
                        "color": "green"
                      },
                      "1": {
                        "text": "ON",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 13,
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 23
