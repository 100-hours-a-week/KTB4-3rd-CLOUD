    {
      "type": "timeseries",
      "title": "보류 실패·오류 (1분 증가)",
      "description": "0이어야 한다. connect_timeout_server_max(10초)를 넘기면 대기 중인 클라이언트가 9001을 받는다 → 7초 중단 기준(R-a)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(proxysql_max_connect_timeouts_total{job=\"migration-proxysql\"}[1m]))",
          "legendFormat": "max connect timeout (9001)",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(proxysql_generated_error_packets_total{job=\"migration-proxysql\"}[1m]))",
          "legendFormat": "ProxySQL이 만든 오류 패킷",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (increase(proxysql_mysql_error_total{job=\"migration-proxysql\"}[1m]))",
          "legendFormat": "backend 오류 {{code}}",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (endpoint) (increase(proxysql_connpool_conns_total{job=\"migration-proxysql\", status=\"err\"}[1m]))",
          "legendFormat": "연결 실패 {{endpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
