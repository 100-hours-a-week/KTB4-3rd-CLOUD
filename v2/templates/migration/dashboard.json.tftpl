    {
      "type": "row",
      "title": "복제 · writer 판정 (S2 정방향 V1→RDS · S6~ 역방향 RDS→V1)",
      "collapsed": false,
      "id": 9,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "RDS — 복제 상태 (정방향: RDS가 V1 binlog 적용)",
      "description": "S2~S4. S4 게이트: lag_s = 0, 적용 위치 = V1 위치 (위치는 `mig status`). 행이 없으면 복제가 설정되지 않은 상태",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-mig-rds"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-mig-rds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  c.CHANNEL_NAME AS channel,\n  c.SOURCE_UUID AS source_uuid,\n  c.SERVICE_STATE AS io_thread,\n  (SELECT GROUP_CONCAT(DISTINCT a.SERVICE_STATE) FROM performance_schema.replication_applier_status_by_worker a WHERE a.CHANNEL_NAME = c.CHANNEL_NAME) AS sql_thread,\n  (SELECT ROUND(MAX(IF(w.APPLYING_TRANSACTION = '', 0, TIMESTAMPDIFF(MICROSECOND, w.APPLYING_TRANSACTION_ORIGINAL_COMMIT_TIMESTAMP, NOW(6)) / 1000000)), 3)\n     FROM performance_schema.replication_applier_status_by_worker w WHERE w.CHANNEL_NAME = c.CHANNEL_NAME) AS lag_s,\n  (SELECT MAX(w.LAST_APPLIED_TRANSACTION_END_APPLY_TIMESTAMP) FROM performance_schema.replication_applier_status_by_worker w WHERE w.CHANNEL_NAME = c.CHANNEL_NAME) AS last_applied_at,\n  c.LAST_HEARTBEAT_TIMESTAMP AS last_heartbeat,\n  CONCAT_WS(' | ', NULLIF(c.LAST_ERROR_MESSAGE, ''),\n    (SELECT GROUP_CONCAT(NULLIF(w.LAST_ERROR_MESSAGE, '') SEPARATOR ' | ') FROM performance_schema.replication_applier_status_by_worker w WHERE w.CHANNEL_NAME = c.CHANNEL_NAME)) AS last_error\nFROM performance_schema.replication_connection_status c"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lag_s"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last_error"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 10,
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "table",
      "title": "V1 Prod — 복제 상태 (역방향: V1이 RDS binlog 적용)",
      "description": "S6 이후. 롤백 사본의 신선도(D-7). 끊겨 있으면 R-c 롤백 시 그 구간이 유실된다",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-mig-v1"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-mig-v1"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  c.CHANNEL_NAME AS channel,\n  c.SOURCE_UUID AS source_uuid,\n  c.SERVICE_STATE AS io_thread,\n  (SELECT GROUP_CONCAT(DISTINCT a.SERVICE_STATE) FROM performance_schema.replication_applier_status_by_worker a WHERE a.CHANNEL_NAME = c.CHANNEL_NAME) AS sql_thread,\n  (SELECT ROUND(MAX(IF(w.APPLYING_TRANSACTION = '', 0, TIMESTAMPDIFF(MICROSECOND, w.APPLYING_TRANSACTION_ORIGINAL_COMMIT_TIMESTAMP, NOW(6)) / 1000000)), 3)\n     FROM performance_schema.replication_applier_status_by_worker w WHERE w.CHANNEL_NAME = c.CHANNEL_NAME) AS lag_s,\n  (SELECT MAX(w.LAST_APPLIED_TRANSACTION_END_APPLY_TIMESTAMP) FROM performance_schema.replication_applier_status_by_worker w WHERE w.CHANNEL_NAME = c.CHANNEL_NAME) AS last_applied_at,\n  c.LAST_HEARTBEAT_TIMESTAMP AS last_heartbeat,\n  CONCAT_WS(' | ', NULLIF(c.LAST_ERROR_MESSAGE, ''),\n    (SELECT GROUP_CONCAT(NULLIF(w.LAST_ERROR_MESSAGE, '') SEPARATOR ' | ') FROM performance_schema.replication_applier_status_by_worker w WHERE w.CHANNEL_NAME = c.CHANNEL_NAME)) AS last_error\nFROM performance_schema.replication_connection_status c"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lag_s"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last_error"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 11,
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 18
      }
    },
    {
      "type": "table",
      "title": "RDS — writer 판정",
      "description": "read_only 파라미터 반영 시간은 TC-12에서 잰다. active_sessions = 사용자 세션 중 Sleep이 아닌 것",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-mig-rds"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-mig-rds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  @@server_id AS server_id,\n  @@read_only AS read_only,\n  @@super_read_only AS super_read_only,\n  (SELECT COUNT(*) FROM information_schema.processlist\n    WHERE command NOT IN ('Sleep', 'Daemon', 'Binlog Dump', 'Binlog Dump GTID', 'Connect')\n      AND user NOT IN ('system user', 'event_scheduler', 'mig_mon', 'rdsadmin')) AS active_sessions,\n  (SELECT COUNT(*) FROM information_schema.processlist WHERE command IN ('Binlog Dump', 'Binlog Dump GTID')) AS binlog_dump_threads"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "read_only|super_read_only"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OFF (쓰기 가능)",
                        "color": "green"
                      },
                      "1": {
                        "text": "ON",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
