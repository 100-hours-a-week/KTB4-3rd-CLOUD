    },
    {
      "type": "table",
      "title": "V1 Prod — 진행 중 트랜잭션",
      "description": "S3 직전에 5초 넘는 트랜잭션이 있으면 보류를 미룬다 (R-4). 덤프(--single-transaction)도 여기 보인다",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-mig-v1"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-mig-v1"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  trx_mysql_thread_id AS thread,\n  trx_state AS state,\n  TIMESTAMPDIFF(SECOND, trx_started, NOW()) AS age_s,\n  trx_rows_locked AS rows_locked,\n  trx_rows_modified AS rows_modified,\n  LEFT(IFNULL(trx_query, ''), 160) AS query\nFROM information_schema.innodb_trx\nORDER BY trx_started\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "age_s|wait_s"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 3
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
