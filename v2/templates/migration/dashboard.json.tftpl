    {
      "type": "timeseries",
      "title": "백엔드 ping 지연 (monitor)",
      "description": "ProxySQL monitor(mig_mon) ping. 값이 끊기면 monitor 계정·TLS를 확인한다 (ping 실패가 쌓이면 SHUNNED)",
      "datasource": {
        "type": "prometheus",
