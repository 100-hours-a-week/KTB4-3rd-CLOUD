#!/bin/bash
# 이관 리허설 v1-sim 부트스트랩 (Amazon Linux 2023) — migration.tf
#   1) Docker · Compose 플러그인 · envsubst 설치
#   2) 이관 버킷 config/ 에서 mig 스크립트를 받아 /usr/local/bin/mig 로 설치
#   3) mig render : SSM 비밀값 → env 파일·proxysql.cnf → docker compose up
#      비밀값이 CHANGE_ME면 컨테이너를 띄우지 않고 끝난다 (값을 넣고 `sudo mig render`)
set -Eeuo pipefail
exec > >(tee /var/log/moyeota-v1sim-bootstrap.log | logger -t moyeota-v1sim -s 2>/dev/console) 2>&1

dnf install -y docker gettext jq
systemctl enable --now docker

if ! docker compose version >/dev/null 2>&1; then
  install -d -m 0755 /usr/local/lib/docker/cli-plugins
  curl --fail --location --show-error --silent \
    "https://github.com/docker/compose/releases/download/${docker_compose_version}/docker-compose-linux-x86_64" \
    --output /usr/local/lib/docker/cli-plugins/docker-compose
  chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
fi

cat > /etc/moyeota-v1sim.env <<ENV
MIG_BUCKET=${bucket}
AWS_REGION=${aws_region}
ENV
chmod 0644 /etc/moyeota-v1sim.env

for _ in $(seq 1 30); do
  aws s3 cp "s3://${bucket}/config/bin/mig" /usr/local/bin/mig --region "${aws_region}" --only-show-errors && break
  echo "waiting for instance profile / config object" >&2
  sleep 10
done
[ -s /usr/local/bin/mig ] || { echo "mig download failed" >&2; exit 1; }
chmod 0755 /usr/local/bin/mig

/usr/local/bin/mig render || echo "mig render stopped — fill the SSM parameters, then run: sudo mig render" >&2
