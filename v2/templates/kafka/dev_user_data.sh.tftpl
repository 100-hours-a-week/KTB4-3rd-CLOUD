#!/usr/bin/env bash
# dev Kafka 호스트 부트스트랩 (kafka_dev.tf)
#   Docker 설치 → compose·토픽 스크립트 배치 → 브로커 기동과 토픽 생성.
#   데이터는 루트 볼륨의 Docker 볼륨에 있어 stop/start에도 유지되고, 재부팅 후에는 Docker가 브로커만 다시 띄운다.
set -Eeuo pipefail
exec > >(tee /var/log/kafka-bootstrap.log | logger -t kafka-bootstrap -s 2>/dev/console) 2>&1

APP_DIR="/opt/kafka"

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-compose-v2
systemctl enable --now docker
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent || true

install -d -m 0755 "$${APP_DIR}"
echo "${compose_b64}" | base64 -d > "$${APP_DIR}/compose.yaml"
echo "${topics_b64}" | base64 -d > "$${APP_DIR}/topics.sh"

token="$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
private_ip="$(curl -fsS -H "X-aws-ec2-metadata-token: $${token}" http://169.254.169.254/latest/meta-data/local-ipv4)"

cat > "$${APP_DIR}/.env" <<ENV
KAFKA_IMAGE=${kafka_image}
KAFKA_ADVERTISED_HOST=$${private_ip}
ENV

cd "$${APP_DIR}"
docker compose up -d
for _ in $(seq 1 60); do
  state="$(docker inspect -f '{{.State.Status}}:{{.State.ExitCode}}' kafka-init 2>/dev/null || true)"
  [[ "$${state}" == exited:* ]] && break
  sleep 5
done
docker logs kafka-init 2>&1 | tail -n 15
[[ "$${state}" == "exited:0" ]] || { echo "kafka-init failed: $${state}" >&2; exit 1; }
echo "dev Kafka bootstrap complete"
