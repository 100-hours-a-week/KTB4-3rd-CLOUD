#!/usr/bin/env bash
set -Eeuo pipefail
exec > >(tee /var/log/moyeota-v2-bootstrap.log | logger -t moyeota-v2-bootstrap -s 2>/dev/console) 2>&1
PROJECT_NAME="${project_name}"
ENVIRONMENT="${environment}"
AWS_REGION="${aws_region}"
COMPOSE_VERSION="${docker_compose_version}"
MOUNT_DATA_VOLUME="${mount_data_volume}"
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y curl xfsprogs docker.io snapd
systemctl enable --now docker
systemctl enable --now snapd.socket || true
systemctl enable --now amazon-ssm-agent || true
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent || true
snap start amazon-ssm-agent || true
if ! docker compose version >/dev/null 2>&1; then
  install -d -m 0755 /usr/local/lib/docker/cli-plugins
  curl --fail --location --show-error --silent \
    "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
    --output /usr/local/lib/docker/cli-plugins/docker-compose
  chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
fi
install -d -m 0750 "/opt/$${PROJECT_NAME}/deploy"
touch "/opt/$${PROJECT_NAME}/deploy/runtime.env" "/opt/$${PROJECT_NAME}/deploy/release.env"
chmod 0600 "/opt/$${PROJECT_NAME}/deploy/runtime.env" "/opt/$${PROJECT_NAME}/deploy/release.env"
grep -q '^APP_ENV=' "/opt/$${PROJECT_NAME}/deploy/runtime.env" || \
  printf 'APP_ENV=%s\nAWS_REGION=%s\n' "$${ENVIRONMENT}" "$${AWS_REGION}" >> "/opt/$${PROJECT_NAME}/deploy/runtime.env"
if [[ "$${MOUNT_DATA_VOLUME}" == "true" ]]; then
  DATA_MOUNT="/mnt/docker-data"
  install -d -m 0750 "$${DATA_MOUNT}"
  root_source="$(findmnt -n -o SOURCE /)"
  root_disk="$(lsblk -no PKNAME "$${root_source}" 2>/dev/null || true)"
  data_device=""
  for _ in $(seq 1 60); do
    while read -r candidate candidate_type; do
      [[ "$${candidate_type}" == "disk" ]] || continue
      [[ "$(basename "$${candidate}")" == "$${root_disk}" ]] && continue
      data_device="$${candidate}"
      break
    done < <(lsblk -dnpo NAME,TYPE)
    [[ -n "$${data_device}" ]] && break
    sleep 5
  done
  if [[ -z "$${data_device}" ]]; then
    echo "Dev data EBS did not appear within 300 seconds" >&2
    exit 1
  fi
  if ! blkid "$${data_device}" >/dev/null 2>&1; then
    mkfs.xfs -f "$${data_device}"
  fi
  data_uuid="$(blkid -s UUID -o value "$${data_device}")"
  grep -q "UUID=$${data_uuid} $${DATA_MOUNT} " /etc/fstab || \
    echo "UUID=$${data_uuid} $${DATA_MOUNT} xfs defaults,nofail 0 2" >> /etc/fstab
  mountpoint -q "$${DATA_MOUNT}" || mount "$${DATA_MOUNT}"
  install -d -m 0711 "$${DATA_MOUNT}/docker"
  cat >/etc/docker/daemon.json <<EOF
{
  "data-root": "$${DATA_MOUNT}/docker",
  "live-restore": true,
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "5"
  }
}
EOF
  systemctl restart docker
fi