# PLG 스택 (moyeota-monitoring-sync가 S3에서 받아 docker compose로 맞춘다)
#   - 이미지 버전은 Terraform 변수(images)로 고정한다
#   - 비밀값은 ../.env (SSM → sync 스크립트)에서만 주입한다
name: monitoring

x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  prometheus:
    image: ${prometheus_image}
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=${prometheus_retention_days}d
      - --web.enable-lifecycle
    ports:
      - "127.0.0.1:9090:9090"
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - ${data_dir}/prometheus:/prometheus
    restart: unless-stopped
    logging: *logging

  loki:
    image: ${loki_image}
    command:
      - -config.file=/etc/loki/loki.yaml
    ports:
      # Alloy(각 ECS 컨테이너 인스턴스)가 push한다. SG가 ECS 인스턴스 SG만 허용한다.
      - "3100:3100"
    volumes:
      - ./loki:/etc/loki:ro
      - ${data_dir}/loki:/loki
    restart: unless-stopped
    logging: *logging

  grafana:
    image: ${grafana_image}
    env_file:
      - ../.env
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
%{ if grafana_root_url != "" ~}
      GF_SERVER_ROOT_URL: "${grafana_root_url}"
%{ endif ~}
    ports:
      - "3000:3000"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - ${data_dir}/grafana:/var/lib/grafana
    depends_on:
      - prometheus
      - loki
    restart: unless-stopped
    logging: *logging
