{
  "uid": "moyeota-v2-infra",
  "title": "V2 인프라 (CloudWatch)",
  "description": "ALB · ECS(Container Insights) · ElastiCache · 모니터링 호스트 하트비트. AWS 지표는 복제하지 않고 CloudWatch 데이터소스로 조회한다. 아래 [부하 테스트] 행에 Non-Prod ALB 대상 그룹·ECS 확장·EC2 크레딧·Service Connect·RDS·ElastiCache Pub/Sub·NAT 지표를 접어 두었다.",
  "tags": [
    "moyeota",
    "v2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "stage",
        "label": "Stage",
        "type": "custom",
        "query": "prod,stg,dev",
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          },
          {
            "text": "stg",
            "value": "stg",
            "selected": false
          },
          {
            "text": "dev",
            "value": "dev",
            "selected": true
          }
        ],
        "hide": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 0,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "부하 테스트 실행 (loadtest 태그)",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "loadtest"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "moyeota"
      ],
      "asDropdown": true,
      "title": "Moyeota V2",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Prod ALB",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "요청량",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "LoadBalancer": "${prod_alb}"
          },
          "matchExact": true,
          "statistic": "Sum",
          "period": "",
          "id": "",
          "expression": "",
          "label": "요청"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
