    {
      "id": 4,
      "type": "row",
      "title": "[부하 테스트] 이상 징후 — 풀·잠금·relay·AI·스케줄러 로그 (LP-01·02·06·09·13)",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": [
        {
          "type": "timeseries",
          "title": "태그별 WARN · ERROR 로그 (분당)",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "expr": "sum by (service, tag) (count_over_time({stage=\"$stage\", service=~\"$service\"} |~ \"WARN|ERROR\" | json | __error__=\"\" | log_level=~\"WARN|ERROR\" | regexp `\\[(?P<tag>[A-Z][A-Z_]{2,})\\]` [1m]))",
              "queryType": "range",
              "legendFormat": "{{service}} {{tag}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "lineWidth": 1,
                "fillOpacity": 10,
                "stacking": {
                  "mode": "none"
                }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "mean",
                "max",
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "description": "BE 로그의 [TAG] 접두사로 묶는다. 태그 없는 ERROR(스택 트레이스 등)는 아래 패턴 패널에서 본다.",
          "id": 5,
          "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 25
          }
        },
        {
          "type": "timeseries",
          "title": "DB · 풀 · 잠금 · 메모리 오류 패턴 (분당)",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "expr": "sum(count_over_time({stage=\"$stage\", service=~\"$service\"} |= \"Connection is not available, request timed out\" [1m]))",
              "queryType": "range",
              "legendFormat": "Hikari 획득 timeout"
            },
            {
              "refId": "B",
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "expr": "sum(count_over_time({stage=\"$stage\", service=~\"$service\"} |~ \"Lock wait timeout exceeded|Deadlock found|CannotAcquireLockException\" [1m]))",
              "queryType": "range",
              "legendFormat": "row lock · deadlock"
            },
            {
              "refId": "C",
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "expr": "sum(count_over_time({stage=\"$stage\", service=~\"$service\"} |= \"Too many connections\" [1m]))",
              "queryType": "range",
              "legendFormat": "DB 연결 상한"
            },
            {
              "refId": "D",
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "expr": "sum(count_over_time({stage=\"$stage\", service=~\"$service\"} |~ \"RedisCommandTimeoutException|RedisConnectionFailureException|Unable to connect to Redis\" [1m]))",
              "queryType": "range",
              "legendFormat": "Redis 연결 · timeout"
            },
            {
              "refId": "E",
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "expr": "sum(count_over_time({stage=\"$stage\", service=~\"$service\"} |= \"OutOfMemoryError\" [1m]))",
              "queryType": "range",
              "legendFormat": "OOM"
            },
            {
              "refId": "F",
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "expr": "sum(count_over_time({stage=\"$stage\", service=~\"$service\"} |= \"[INTERNAL_ERROR]\" [1m]))",
              "queryType": "range",
              "legendFormat": "INTERNAL_ERROR (500)"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "lineWidth": 1,
                "fillOpacity": 10,
                "stacking": {
                  "mode": "none"
                }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "mean",
                "max",
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "description": "LP-01·02·04·06의 실패가 로그로 나타나는 형태. MySQL deadlock은 CloudWatch 지표가 없어 여기서 센다.",
          "id": 6,
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 33
          }
        },
        {
          "type": "timeseries",
          "title": "WebSocket · Redis relay 로그 (태그별, 분당)",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "expr": "sum by (tag) (count_over_time({stage=\"$stage\", service=~\"$service\"} |~ `STOMP_|WS_RELAY_|_SUBSCRIBE\\]` | regexp `\\[(?P<tag>(STOMP|WS_RELAY|NON_PARTICIPANT|UNSUPPORTED)_[A-Z_]+)\\]` [1m]))",
              "queryType": "range",
              "legendFormat": "{{tag}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "lineWidth": 1,
                "fillOpacity": 10,
                "stacking": {
                  "mode": "none"
