              "calcs": [
                "mean",
                "max",
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "description": "METER_ANALYSIS_REJECTED = BE 대기열 초과, AI_ANALYSIS_FAILED = FastAPI 호출 실패 (LP-08·09·14).",
          "id": 8,
