            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "calcs": [
                "mean",
                "max",
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "description": "STOMP_CONNECTED(연결), WS_RELAY_SUBSCRIBED(구독 완료), WS_RELAY_PUBLISH_FAILED·HANDLE_FAILED(전달 실패), NON_PARTICIPANT_SUBSCRIBE(권한 없는 구독) (LP-05·06·16).",
          "id": 7,
          "gridPos": {
