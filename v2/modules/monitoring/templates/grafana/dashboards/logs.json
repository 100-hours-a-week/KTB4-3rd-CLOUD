              "expr": "sum by (tag) (count_over_time({stage=\"$stage\", service=~\"$service\"} |~ `AI_ANALYSIS|METER_ANALYSIS|KAKAO_|FCM_` | regexp `\\[(?P<tag>(AI_ANALYSIS|METER_ANALYSIS|KAKAO|FCM)_[A-Z_]+)\\]` [1m]))",
              "queryType": "range",
              "legendFormat": "{{tag}}"
