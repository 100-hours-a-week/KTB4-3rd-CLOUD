# Grafana 데이터소스 (UID 고정: 대시보드·알림 규칙이 이 UID를 참조한다)
apiVersion: 1

# 예전 UID·이름으로 DB에 남은 MySQL 데이터소스를 먼저 지운다 (Grafana는 삭제를 생성보다 먼저 처리한다).
#   Migration V1 (v1-sim): 예전 시뮬레이션 행이 UID mysql-mig-v1을 점유한다.
#   Migration V1 (prod)  : 10/24 apply로 UID mysql-mig-v1-prod가 기록된 행이다. 이름이 같아 생성이 실패한다.
deleteDatasources:
  - name: Migration V1 (v1-sim)
    orgId: 1
  - name: Migration V1 (prod)
    orgId: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://loki:3100
    editable: false

  # 인스턴스 Role(AWS SDK 기본 자격 증명 체인)로 ALB·ECS·RDS·ElastiCache 지표와 CloudWatch Logs를 조회한다
  - name: CloudWatch
    uid: cloudwatch
    type: cloudwatch
    editable: false
    jsonData:
      authType: default
      defaultRegion: ${region}
%{ for d in mysql_datasources ~}

  # ${d.name} — 비밀번호는 Grafana 컨테이너 환경 변수 ${d.password_env} (sync.sh → ../.env)
  - name: ${d.name}
    uid: ${d.uid}
    type: mysql
    access: proxy
    url: ${d.url}
    user: ${d.user}
    editable: false
    jsonData:
      database: information_schema
      maxOpenConns: 5
      maxIdleConns: 2
      connMaxLifetime: 300
      timeInterval: 15s
    secureJsonData:
      password: $__env{${d.password_env}}
%{ endfor ~}
