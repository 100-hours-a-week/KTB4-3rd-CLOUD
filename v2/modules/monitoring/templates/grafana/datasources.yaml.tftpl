# Grafana 데이터소스 (UID 고정: 대시보드·알림 규칙이 이 UID를 참조한다)
apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://loki:3100
    editable: false

  # 인스턴스 Role(AWS SDK 기본 자격 증명 체인)로 ALB·ECS·RDS·ElastiCache 지표와 CloudWatch Logs를 조회한다
  - name: CloudWatch
    uid: cloudwatch
    type: cloudwatch
    editable: false
    jsonData:
      authType: default
      defaultRegion: ${region}
%{ for d in mysql_datasources ~}

  # ${d.name} — 비밀번호는 Grafana 컨테이너 환경 변수 ${d.password_env} (sync.sh → ../.env)
  - name: ${d.name}
    uid: ${d.uid}
    type: mysql
    access: proxy
    url: ${d.url}
    user: ${d.user}
    editable: false
    jsonData:
      database: information_schema
      maxOpenConns: 5
      maxIdleConns: 2
      connMaxLifetime: 300
      timeInterval: 15s
    secureJsonData:
      password: $__env{${d.password_env}}
%{ endfor ~}
