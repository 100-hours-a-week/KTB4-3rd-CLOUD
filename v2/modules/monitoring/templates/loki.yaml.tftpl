# Loki (single binary) — 로그 블록은 S3, 보존은 compactor가 stage별로 지운다
auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096
  log_level: info

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
  storage:
    s3:
      region: ${region}
      bucketnames: ${logs_bucket}

schema_config:
  configs:
    - from: "2026-10-01"
      store: tsdb
      object_store: s3
      schema: v13
      index:
        prefix: index_
        period: 24h

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: s3

limits_config:
  # prod 기본 보존, dev·stg 스트림은 더 짧게 (Alloy가 stage 라벨을 붙인다)
  retention_period: ${retention_prod_hours}h
  retention_stream:
    - selector: '{stage=~"dev|stg"}'
      priority: 1
      period: ${retention_nonprod_hours}h
  reject_old_samples: true
  reject_old_samples_max_age: 168h
  allow_structured_metadata: true
  volume_enabled: true

analytics:
  reporting_enabled: false
