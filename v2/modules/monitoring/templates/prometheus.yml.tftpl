# Prometheus — 모니터링 호스트 (Terraform modules/monitoring이 생성, 직접 수정하지 않는다)
global:
  scrape_interval: 30s
  scrape_timeout: 10s
  evaluation_interval: 30s
  external_labels:
    monitor: ${project_name}

rule_files:
  - /etc/prometheus/rules/*.yml

# OTLP push(--web.enable-otlp-receiver)로 들어온 리소스 속성을 라벨로 올린다.
# pull이 붙이는 stage·service 라벨과 같은 이름이라 대시보드·알림을 바꾸지 않아도 된다 (앱이 두 키를 보낸다).
otlp:
  promote_resource_attributes:
    - stage
    - service

scrape_configs:
  # 모니터링 스택 자체
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          stage: monitoring
          service: prometheus

  - job_name: loki
    static_configs:
      - targets: ["loki:3100"]
        labels:
          stage: monitoring
          service: loki

  - job_name: grafana
    static_configs:
      - targets: ["grafana:3000"]
        labels:
          stage: monitoring
          service: grafana
%{ for t in scrape_targets ~}

  # ECS ${t.stage} ${t.service} — Cloud Map A 레코드로 현재 태스크 전체를 찾는다
  - job_name: ${t.job}
    metrics_path: ${t.metrics_path}
    dns_sd_configs:
      - names: ["${t.dns_name}"]
        type: A
        port: ${t.port}
        refresh_interval: 30s
    relabel_configs:
      - target_label: stage
        replacement: ${t.stage}
      - target_label: service
        replacement: ${t.service}
%{ endfor ~}
%{ for t in static_scrape_targets ~}

  # ${t.stage} ${t.service} — ECS 밖 고정 대상 (static_scrape_targets)
  - job_name: ${t.job}
    metrics_path: ${t.metrics_path}
    scrape_interval: 15s
    static_configs:
      - targets: [${join(", ", [for x in t.targets : "\"${x}\""])}]
        labels:
          stage: ${t.stage}
          service: ${t.service}
%{ endfor ~}
